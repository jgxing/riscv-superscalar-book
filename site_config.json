    "pattern": "第??章_*.md",
    "out_prefix": "ch"
  },
  "back": [
    {"src": "附录A_Digital使用指南.md", "out": "appendix-a.html", "label": "附录A"},
    {"src": "附录B_Verilog模块模板.md", "out": "appendix-b.html", "label": "附录B"},
    {"src": "附录C_术语与参数速查.md", "out": "appendix-c.html", "label": "附录C"}
